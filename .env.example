# Flask secret: generate a long random value, never publish it
FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('YOUR_PASSWORD'))"
ADMIN_PASSWORD_HASH=replace-with-generated-password-hash
# Paste the pooled or direct PostgreSQL connection URL from Neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
COOKIE_SECURE=true
